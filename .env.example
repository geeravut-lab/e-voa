# ---- Public (safe for the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://ytzktizvmeayugdfzzlk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://e-voa.vercel.app
# Set to 0 (and rebuild) to disable the realtime socket and use polling only
NEXT_PUBLIC_LIVE_REALTIME=1

# ---- Server only. NEVER prefix these with NEXT_PUBLIC_ ----
SUPABASE_SERVICE_ROLE_KEY=
# The owner account: cannot be removed from admins (compare lower-cased)
OWNER_EMAIL=
# Aivora (LINE) SSO
AIVORA_HUB_URL=https://aivora-lc.netlify.app
AIVORA_APP_SLUG=e-voa
# Vercel Cron sends this as a Bearer token (Vercel sets it automatically when CRON_SECRET exists)
CRON_SECRET=

# ---- Immigration Bureau link (Phase 1) ----
# Live values come from Immigration. For development run `npm run mock` and use the simulator:
IMMIGRATION_API_URL=http://localhost:4010/immigration/th/v1
IMMIGRATION_API_TOKEN=
IMMIGRATION_API_FROM=
# Shared secret Immigration puts in "Authorization: Bearer …" when it calls /api/immigration/callback
IMMIGRATION_CALLBACK_SECRET=
# 32 random bytes, base64: encrypts passport numbers and document files. LOSING IT MAKES THEM UNREADABLE. Back it up.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
