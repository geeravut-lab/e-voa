# ---- Public (safe for the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://ytzktizvmeayugdfzzlk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://e-voa.vercel.app
# Set to 0 (and rebuild) to disable the realtime socket and use polling only
NEXT_PUBLIC_LIVE_REALTIME=1

# ---- Server only. NEVER prefix these with NEXT_PUBLIC_ ----
SUPABASE_SERVICE_ROLE_KEY=
# Aivora (LINE) SSO
AIVORA_HUB_URL=https://aivora-lc.netlify.app
AIVORA_APP_SLUG=e-voa
# Vercel Cron sends this as a Bearer token (Vercel sets it automatically when CRON_SECRET exists)
CRON_SECRET=

# ---- Immigration Bureau link (Phase 1) ----
# Live values come from Immigration. For development run `npm run mock` and use the simulator:
IMMIGRATION_API_URL=http://localhost:4010/immigration/th/v1
IMMIGRATION_API_TOKEN=
IMMIGRATION_API_FROM=
# Shared secret Immigration puts in "Authorization: Bearer …" when it calls /api/immigration/callback
IMMIGRATION_CALLBACK_SECRET=
# 32 random bytes, base64: encrypts passport numbers and document files. LOSING IT MAKES THEM UNREADABLE. Back it up.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# ---- Payments: Stripe (Phase 2). TEST keys (sk_test_…) only until you decide to go live ----
STRIPE_SECRET_KEY=
# Signing secret of the webhook you register in Stripe for https://e-voa.vercel.app/api/stripe/webhook (events: checkout.session.completed, checkout.session.expired)
STRIPE_WEBHOOK_SECRET=

# ---- Add-on partners (Phase 3). For development run `npm run mock` and use the simulator ----
PARTNER_INSURANCE_URL=http://localhost:4010/insurance/CIS
PARTNER_SIM_URL=http://localhost:4010/sim
PARTNER_VIP_URL=http://localhost:4010/vip
PARTNER_BHS_URL=http://localhost:4010/bhs
# Insurance partner credentials (sent as g-api-key and Bearer token)
INSURANCE_G_API_KEY=
INSURANCE_TOKEN=
# SIM / VIP / Beauty & Health sign each request: X-API-KEY = HMAC-SHA256(PARTNER_SECRET, timestamp). The algorithm is an assumption: confirm with each partner
PARTNER_SECRET=
PARTNER_PUBLIC_KEY=
# Shared secret the partners put in "Authorization: Bearer …" when they call /api/partners/<provider>/<path>
PARTNER_CALLBACK_SECRET=

# ---- Flight lookup (optional). Without it the traveler types airline, airport and time ----
FLIGHT_API_URL=
FLIGHT_API_KEY=

# ---- E-mail notices and receipts (Resend HTTP API) ----
# Without RESEND_API_KEY nothing is mailed (in-app notices still work). The test sender below only delivers to the e-mail of your own Resend account.
RESEND_API_KEY=
MAIL_FROM=ThaiPass e-VOA <onboarding@resend.dev>

# ---- AI help assistant (Phase 4). Without the key the assistant says it is unavailable; everything else works ----
ANTHROPIC_API_KEY=
# Only for tests (the simulator): ANTHROPIC_BASE_URL=http://localhost:4010/ai
ANTHROPIC_BASE_URL=

# ---- LINE and WhatsApp notices (Phase 4). Every value is optional; a channel without its values is simply hidden from travelers ----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# The official account's basic id, e.g. @123abcde (shown on the "connect LINE" screen). Webhook URL to register in LINE: https://e-voa.vercel.app/api/line/webhook
LINE_BASIC_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Names of the two approved message templates (see docs/evoa/05-SETUP.md)
WHATSAPP_TEMPLATE_NOTICE=
WHATSAPP_TEMPLATE_CODE=
WHATSAPP_TEMPLATE_LANG=en
